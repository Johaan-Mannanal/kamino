{
	admin off
	auto_https off
}

:{$PORT:8080} {
	@www host www.kamino.design
	redir @www https://kamino.design{uri} 308
	encode zstd gzip
	header {
		# Railway serves this listener only behind its HTTPS edge.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}
	request_body {
		max_size 70MB
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM}
	}
	handle {
		root * {$WEB_ROOT:/srv}
		file_server
	}
	handle_errors 404 {
		root * {$WEB_ROOT:/srv}
		rewrite * /404.html
		file_server
	}
}
