# Export these into your shell; the backend does not automatically load .env.
# Keep real credentials local, never in Git. Mock is the default and spends no credits.
PHOTO2SIM_PROVIDER=mock
PHOTO2SIM_DATA_DIR=artifacts/photo2sim
MESHY_API_KEY=
MESHY_MODEL=meshy-6
# Reserved for teammate integrations; backend does not consume these yet.
GEMINI_API_KEY=
GEMINI_MODEL=
# Add Fetch/Vultr configuration when their integrations are implemented.
