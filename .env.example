# Copy to .env on each machine. Backend reads it from the working directory.
# Shell environment variables override .env. Keep real credentials out of Git.
# Mock is the default and spends no reconstruction credits.
PHOTO2SIM_PROVIDER=mock
PHOTO2SIM_DATA_DIR=artifacts/photo2sim
# Optional locally; required by the public deployment. This is an application token,
# distinct from provider API keys. Team clients send Authorization: Bearer <token>.
PHOTO2SIM_API_TOKEN=
PHOTO2SIM_STUDENT_CODE=
# Opt in to code-free student browser sessions; requires token + student code.
PHOTO2SIM_PUBLIC_STUDENT_ACCESS=false
PHOTO2SIM_JUDGE_CODE=
PHOTO2SIM_TEAM_CODE=
# Railway backend: HTTPS frontend origin, e.g. https://kamino.design (blank locally).
PHOTO2SIM_PUBLIC_ORIGIN=
PHOTO2SIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MESHY_API_KEY=
MESHY_MODEL=meshy-6

# Gemini: optional property suggestions, separate from confirmed properties.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_MAX_ATTEMPTS=2
GEMINI_DEADLINE_SECONDS=75
GEMINI_BACKOFF_SECONDS=0.5
