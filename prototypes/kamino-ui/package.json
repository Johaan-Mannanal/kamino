{
  "name": "kamino-ui-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1 --port 5188 --strictPort",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --port 5188 --strictPort",
    "test": "vitest run --configLoader native",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:live": "node scripts/verify-live.cjs",
    "prebuild": "node ../../tools/branding/sync-assets.mjs --check --frontend-only",
    "test:readiness": "node scripts/verify-readiness.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "jsdom": "30.1.3",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
